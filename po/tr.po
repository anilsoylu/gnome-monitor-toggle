#: monitorctl.py:42
msgid "Confirm “Keep Changes” in the GNOME dialog within 20 seconds, or the change is reverted."
msgstr "Değişikliği korumak için GNOME penceresinde 20 saniye içinde “Değişiklikleri Sakla” düğmesine basın, yoksa geri alınır."

#: monitorctl.py:61
msgid "GNOME display settings are not available in this session."
msgstr "Bu oturumda GNOME ekran ayarlarına erişilemiyor."

#: monitorctl.py:64
msgid "Changing displays over D-Bus is disabled on this system."
msgstr "Bu sistemde ekranları D-Bus üzerinden değiştirmek kapatılmış."

#: monitorctl.py:65
msgid "The display setup changed in the meantime. Try again."
msgstr "Ekran düzeni bu sırada değişti. Tekrar deneyin."

#: monitorctl.py:68
#, python-brace-format
msgid "GNOME rejected this layout: {reason}"
msgstr "GNOME bu düzeni kabul etmedi: {reason}"

#: monitorctl.py:216
msgid "At least one display must stay on."
msgstr "En az bir ekran açık kalmalı."

#: monitorctl.py:273
#, python-brace-format
msgid "'{connector}' is not connected."
msgstr "'{connector}' bağlı değil."

#: monitor:19
msgid "Connected displays:"
msgstr "Bağlı ekranlar:"

#: monitor:25
msgid "primary"
msgstr "birincil"

#: monitor:26
msgid "on"
msgstr "açık"

#: monitor:26
msgid "off"
msgstr "kapalı"

#: monitor:31
msgid "Turn GNOME displays on and off."
msgstr "GNOME ekranlarını açıp kapatır."

#: monitor:33
msgid "list connected displays"
msgstr "bağlı ekranları listeler"

#: monitor:35
msgid "turn a display off"
msgstr "bir ekranı kapatır"

#: monitor:36
msgid "turn a display on (all displays without an argument)"
msgstr "bir ekranı açar (argümansız: tüm ekranları)"

#: monitor:37
msgid "keep only this display on"
msgstr "yalnızca bu ekranı açık bırakır"

#: monitor:40
msgid "for example DP-1 or HDMI-A-1"
msgstr "örneğin DP-1 veya HDMI-A-1"

#: monitor:41
msgid "keep the change after logging out"
msgstr "değişiklik oturum kapatıldıktan sonra da korunur"

#: monitor:51
#, python-brace-format
msgid "Error: {message}"
msgstr "Hata: {message}"

#: monitor:54
#, python-brace-format
msgid "{connector} turned on."
msgstr "{connector} açıldı."

#: monitor:55
#, python-brace-format
msgid "{connector} turned off. Turn it back on with: monitor on {connector}"
msgstr "{connector} kapatıldı. Geri açmak için: monitor on {connector}"

#: monitor:56
#, python-brace-format
msgid "Only {connector} is on now."
msgstr "Artık yalnızca {connector} açık."

#: monitor:57
msgid "All displays turned on."
msgstr "Tüm ekranlar açıldı."

#: monitor-ui:35
#, python-brace-format
msgid "Monitor Toggle needs GTK {gtk} and libadwaita {adw} or newer (GNOME 47+); found GTK {found_gtk} and libadwaita {found_adw}. The monitor command still works."
msgstr "Monitör Aç/Kapat için GTK {gtk} ve libadwaita {adw} veya daha yenisi gerekir (GNOME 47+); bulunan: GTK {found_gtk}, libadwaita {found_adw}. monitor komutu yine de çalışır."

#: monitor-ui:57
msgid "Display layout"
msgstr "Ekran düzeni"

#: monitor-ui:103 monitor-ui:263
msgid "Primary"
msgstr "Birincil"

#: monitor-ui:103
msgid "Off"
msgstr "Kapalı"

#: monitor-ui:125 monitor-ui:173
msgid "Displays"
msgstr "Ekranlar"

#: monitor-ui:161
msgid "Refresh"
msgstr "Yenile"

#: monitor-ui:162
msgid "About Monitor Toggle"
msgstr "Monitör Aç/Kapat Hakkında"

#: monitor-ui:164
msgid "Main Menu"
msgstr "Ana Menü"

#: monitor-ui:174
msgid "Turn All On"
msgstr "Hepsini Aç"

#: monitor-ui:179
msgid "Remember After Restart"
msgstr "Yeniden Başlatınca Hatırla"

#: monitor-ui:188
msgid "Try Again"
msgstr "Tekrar Dene"

#: monitor-ui:190
msgid "Displays Unavailable"
msgstr "Ekranlara Erişilemiyor"

#: monitor-ui:212
msgid "Use Only This Display"
msgstr "Yalnızca Bu Ekranı Kullan"

#: monitor-ui:215
msgid "More Options"
msgstr "Diğer Seçenekler"

#: monitor-ui:261
#, python-brace-format
msgid "{rate} Hz"
msgstr "{rate} Hz"

#: monitor-ui:378
#, python-brace-format
msgid "{name} turned off"
msgstr "{name} kapatıldı"

#: monitor-ui:379
#, python-brace-format
msgid "Only {name} is on"
msgstr "Yalnızca {name} açık"

#: monitor-ui:394
msgid "Undo"
msgstr "Geri Al"

#: monitor-ui:439
msgid "Monitor Toggle"
msgstr "Monitör Aç/Kapat"
